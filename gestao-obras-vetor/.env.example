# Public domain, without protocol or trailing slash.
APP_DOMAIN=vetor.damjam.com.br

# Let's Encrypt account contact (renewal/expiration notices).
LETSENCRYPT_EMAIL=admin@damjam.com.br

# Persistent absolute directory on the Linux server for database and uploads.
# Example: /srv/gestao-obras-vetor
APP_DATA_DIR=/srv/gestao-obras-vetor

# PostgreSQL credentials used by docker-compose.yml
POSTGRES_DB=gestao_obras
POSTGRES_USER=gestao_user
POSTGRES_PASSWORD=troque_por_uma_senha_forte

# pgAdmin access
PGADMIN_DEFAULT_EMAIL=admin@gestao-obras.com
PGADMIN_DEFAULT_PASSWORD=troque_por_uma_senha_forte
