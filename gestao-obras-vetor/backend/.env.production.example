# ================================================
# Configuração de PRODUÇÃO para o backend
# ================================================
# Copie este arquivo para .env e edite os valores:
#   cp .env.production.example .env
#   nano .env
# ================================================

PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# OBRIGATÓRIO: troque por uma chave aleatória forte.
# Gere com:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE_AQUI_POR_UMA_CHAVE_ALEATORIA_FORTE

# Sessão persistente. Exemplos: 30d, 90d, 365d
JWT_EXPIRES_IN=30d

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gestao_obras
DB_USER=gestao_user
DB_PASSWORD=TROQUE_AQUI_POR_UMA_SENHA_FORTE
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000
